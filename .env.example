NEBIUS_API_KEY=your_nebius_api_key_here

# Override this with the exact model ID shown in Nebius Token Factory.
# You can use either openai/gpt-oss-120b or nebius/openai/gpt-oss-120b.
# Leaving this placeholder uses the app fallback: nebius/openai/gpt-oss-120b.
NEBIUS_MODEL=your_valid_nebius_model_id_here

# Optional only if using an AgentField memory server.
# Leave unset to run the FastAPI app/UI without persistent memory/events.
AGENTFIELD_BASE_URL=http://localhost:8081
AGENTFIELD_MEMORY_WS_URL=ws://localhost:8081/api/v1/memory/events/ws
